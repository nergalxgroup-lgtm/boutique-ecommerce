generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- UTILISATEURS ----------

enum Role {
  CLIENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  nom           String
  telephone     String?
  role          Role      @default(CLIENT)
  adresses      Adresse[]
  commandes     Commande[]
  createdAt     DateTime  @default(now())
}

model Adresse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   // "Domicile", "Bureau"...
  ville       String
  quartier    String?
  adresseLigne String
  telephone   String
  parDefaut   Boolean  @default(false)
}

// ---------- CATALOGUE ----------

enum Categorie {
  HOMME
  FEMME
  ENFANT
  MIXTE
}

model Produit {
  id          String    @id @default(cuid())
  nom         String
  slug        String    @unique
  description String
  prix        Decimal   @db.Decimal(10, 2)
  prixPromo   Decimal?  @db.Decimal(10, 2)
  categorie   Categorie
  sousCategorie String? // "T-shirt", "Robe", "Ensemble bébé"...
  tailleAge   String?   // pour enfant: "2-3 ans", "4-5 ans"...
  images      Image[]
  variantes   Variante[]
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lignesCommande LigneCommande[]

  @@index([categorie])
}

model Image {
  id        String  @id @default(cuid())
  url       String
  ordre     Int     @default(0)
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
}

// Une variante = combinaison taille/couleur avec son propre stock
model Variante {
  id         String   @id @default(cuid())
  produitId  String
  produit    Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  taille     String   // "S", "M", "L", "36", "2-3 ans"...
  couleur    String
  sku        String   @unique
  stock      Int      @default(0)
  lignesCommande LigneCommande[]

  @@unique([produitId, taille, couleur])
}

// ---------- PANIER / COMMANDES ----------

enum StatutCommande {
  EN_ATTENTE
  PAYEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum ModePaiement {
  CMI
  PAIEMENT_LIVRAISON
  STRIPE
}

model Commande {
  id            String          @id @default(cuid())
  numero        String          @unique // ex: CMD-2026-00001
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  lignes        LigneCommande[]
  sousTotal     Decimal         @db.Decimal(10, 2)
  fraisLivraison Decimal        @db.Decimal(10, 2) @default(0)
  total         Decimal         @db.Decimal(10, 2)
  statut        StatutCommande  @default(EN_ATTENTE)
  modePaiement  ModePaiement
  referencePaiement String?     // ID transaction CMI/Stripe
  adresseLivraison Json
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model LigneCommande {
  id          String   @id @default(cuid())
  commandeId  String
  commande    Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId   String
  produit     Produit  @relation(fields: [produitId], references: [id])
  varianteId  String
  variante    Variante @relation(fields: [varianteId], references: [id])
  quantite    Int
  prixUnitaire Decimal @db.Decimal(10, 2)
}
